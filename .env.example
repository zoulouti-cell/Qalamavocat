# إعدادات نموذجية — قلم
# انسخ هذا الملف إلى .env ثم عدّل القيم.

# منفذ الخدمة
PORT=4310

# عنوان الاستماع: محليًا 127.0.0.1، وفي النشر 0.0.0.0
QALAM_HOST=127.0.0.1

# مسار قاعدة البيانات (افتراضي: qalam.db بجانب التطبيق)
QALAM_DB=./qalam.db

# (اختياري) MongoDB بدل SQLite
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=qalam

# مجلد ملفات الواجهة المبنية
QALAM_WEB_DIR=../../apps/desktop/dist

# النطاقات المسموح لها باستدعاء الواجهة البرمجية (افصل بفواصل)
# للتطوير المحلي: * — وللإنتاج: حدّد نطاق واجهتك فقط
QALAM_ORIGINS=http://127.0.0.1:4310

# امنع إعادة تعيين قاعدة البيانات في الإنتاج
QALAM_ALLOW_RESET=0

# اختياري: مفاتيح Google (الدخول بـ Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
